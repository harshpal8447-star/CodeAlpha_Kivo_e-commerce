# ════════════════════════════════════════════════════════════════════════════════
# Kivo Backend Server Environment Configuration Template
# ════════════════════════════════════════════════════════════════════════════════

# In local development:
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# In production (Railway + Supabase):
# NODE_ENV=production
# CLIENT_URL=https://your-kivo-frontend.vercel.app
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# JWT_SECRET=your_production_secure_jwt_secret_32_chars_min
# JWT_EXPIRES_IN=7d
# COOKIE_SECURE=true
