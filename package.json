{
  "name": "kivo-ecommerce",
  "version": "1.0.0",
  "type": "module",
  "description": "Kivo - Complete Professional E-Commerce Web Application",
  "main": "server/src/server.js",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/dev.js",
    "dev:local": "node scripts/dev-local.js",
    "dev:stop": "node scripts/stop.js",
    "dev:services": "concurrently -n \"api,client\" -c \"cyan,magenta\" --kill-others \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/src/server.js",
    "db:generate": "npx prisma generate",
    "db:generate:pg": "npx prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:pg": "npx prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "db:push": "npx prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:seed:pg": "npx prisma generate --schema=prisma/schema.postgresql.prisma && node prisma/seed.js && npx prisma generate --schema=prisma/schema.prisma",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:setup:pg": "npm run db:migrate:pg && npm run db:seed:pg",
    "test": "npm run test --prefix server",
    "test:client": "npm run test --prefix client"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "prisma": "^5.14.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  },
  "keywords": [
    "ecommerce",
    "react",
    "express",
    "prisma",
    "tailwindcss",
    "kivo"
  ],
  "author": "Kivo Team",
  "license": "ISC"
}
