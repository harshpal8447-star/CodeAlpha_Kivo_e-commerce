# ════════════════════════════════════════════════════════════════════════════════
# Kivo E-Commerce Environment Configuration Template
# ════════════════════════════════════════════════════════════════════════════════

# Docker Compose PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kivo_db
POSTGRES_PORT=5432

# Prisma Database Connection URL (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kivo_db?schema=public"

# Express Backend Server Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=kivo_super_secret_jwt_key_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Initial Admin Credentials (loaded during seed)
ADMIN_EMAIL=admin@kivo.com
ADMIN_PASSWORD=AdminPassword123!
