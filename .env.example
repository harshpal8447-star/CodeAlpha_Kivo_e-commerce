# ════════════════════════════════════════════════════════════════════════════════
# Kivo E-Commerce Environment Configuration Template
# ════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# 1. LOCAL DEVELOPMENT (Default: SQLite)
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# ─────────────────────────────────────────────────────────────────────────────
# 2. PRODUCTION (Railway Backend + Supabase PostgreSQL)
# Set these variables in your Railway Project Settings -> Variables
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV=production
# PORT=5000 (or let Railway set automatically)
# CLIENT_URL=https://your-kivo-frontend.vercel.app
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# (Or direct port 5432: postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres)
# JWT_SECRET=generate_a_secure_random_string_of_at_least_32_characters
# JWT_EXPIRES_IN=7d
# COOKIE_SECURE=true

# ─────────────────────────────────────────────────────────────────────────────
# 3. PRODUCTION (Vercel Frontend)
# Set this variable in your Vercel Project Settings -> Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# VITE_API_URL=https://your-railway-backend.up.railway.app/api
