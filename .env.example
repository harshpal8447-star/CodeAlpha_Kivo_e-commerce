# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL or SQLite)
# For local zero-config SQLite:
DATABASE_URL="file:./dev.db"

# For PostgreSQL (Production / Local PostgreSQL service):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/kivo_db?schema=public"

# Authentication Secrets
JWT_SECRET=kivo_super_secret_jwt_key_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@kivo.com
ADMIN_PASSWORD=AdminPassword123!
